{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "automerge": true,
  // Order matters. applyPackageRules() merges each matching rule over the
  // previous one, so the last match wins: the broad disable must come first
  // and the narrow allowlist second.
  "packageRules": [
    {
      // Copier owns these workflows; Renovate updates would fight the template.
      "matchManagers": ["github-actions"],
      "enabled": false
    },
    {
      // Except these, which are not part of the Copier template.
      "matchManagers": ["github-actions"],
      "matchFileNames": [
        ".github/workflows/continuous-integration.yml"
      ],
      "enabled": true
    }
  ],
  "nix": {
    "enabled": true,
    "lockFileMaintenance": {
      "enabled": true,
      "commitMessageAction": "update",
      "commitMessageTopic": "Nix flake lock"
    }
  }
}
